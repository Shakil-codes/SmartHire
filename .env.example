# SmartHire GenAI Environment Configuration

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Core LLM & Embeddings Configuration
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Paths Configuration
DATA_JOBS_PATH=data/jobs/jobs.csv
RESUMES_DIR=data/resumes
CAREER_NOTES_DIR=data/career_notes
JOB_VECTORSTORE_PATH=vectorstore/job_faiss_index
MENTOR_VECTORSTORE_PATH=vectorstore/career_faiss_index

# Search & Retrieval Parameters
TOP_K_JOBS=5
TOP_K_CAREER_NOTES=3
SIMILARITY_THRESHOLD=0.35
